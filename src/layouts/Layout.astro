          </div>
          <div class="message-field full">
            <label for="message">Message</label>
            <textarea id="message" name="message" placeholder="Tell me how I can help..." required></textarea>
          </div>
          <div class="message-field full">
            <button class="btn btn-primary message-submit" type="submit">Send Message <span>↗</span></button>
          </div>
        </form>
      </div>
    </div>
  </section>

  <script is:inline src="/script.js"></script>
