---
import Layout from "../layouts/Layout.astro";
---
<Layout>
  <main id="home" class="page active">
    <section class="hero"><div class="hero-slideshow"><div class="hero-slide active"><img src="/images/hero-slide-1.jpg" alt="Resource mobilization and partnerships — slide 1"></div><div class="hero-slide"><img src="/images/hero-slide-2.jpg" alt="Resource mobilization and partnerships — slide 2"></div><div class="hero-slide"><img src="/images/hero-slide-3.jpg" alt="Resource mobilization and partnerships — slide 3"></div><div class="hero-gradient"></div></div><div class="container"><div class="hero-content">
      <div class="eyebrow">Partnerships & Resource Mobilization</div>
      <h1>Turning <span>relationships</span> into resources.</h1>
      <p class="hero-description">I help organizations identify the right funding opportunities, develop compelling proposals, and build strategic partnerships.</p>
      <div class="hero-actions">
        <a class="btn btn-light" href="/contact">Work With Me <span>↗</span></a>
      </div>
    </div></div>
      <a class="hero-note" href="/services" aria-label="Explore my services"><div class="icon">◎</div><strong>Explore My Services <span class="hero-note-arrow">→</span></strong></a>
    </section>
    <section class="section"><div class="container"><div class="intro-grid">
      <div class="intro-copy"><div class="eyebrow">What I Do</div><h2>Funding is more than finding a donor.</h2><p>Effective resource mobilization starts with understanding people, priorities and opportunities. I work at the intersection of partnerships, fundraising and development to help organizations move from potential opportunities to meaningful results.</p><a class="btn btn-dark" href="/about#approach">Discover My Approach →</a></div>
      <div class="quote-card"><p>"The strongest partnerships are built where shared purpose, strategic thinking and measurable impact meet."</p><small>Jonathan Oketch</small></div>
    </div></div></section>
    <section class="section" style="padding-top:30px"><div class="container"><div class="section-heading"><div class="eyebrow">Areas of Expertise</div><h2>Where strategy meets opportunity.</h2><p>A practical, relationship-driven approach to building sustainable funding and partnership ecosystems.</p></div>
      <div class="feature-grid">
        <article class="feature-card"><div class="feature-icon">🔎</div><h3>Opportunity Intelligence</h3><p>Identifying compatible donors, foundations and corporate partners aligned with organizational priorities.</p></article>
        <article class="feature-card"><div class="feature-icon">✍️</div><h3>Compelling Proposals</h3><p>Developing concept notes, grant applications and logical frameworks that communicate value clearly.</p></article>
        <article class="feature-card"><div class="feature-icon">🤝</div><h3>Strategic Partnerships</h3><p>Building relationships that create long-term value between organizations, stakeholders and funders.</p></article>
      </div>
    </div></section>
    <section class="cta-section"><div class="container"><div class="cta-box"><h2>Let's build the right partnerships for your next opportunity.</h2><p>Whether you are looking for funding, developing a proposal or strengthening your partnership strategy, let's start a conversation.</p><button class="btn btn-primary" data-open-contact>Get In Touch →</button></div></div></section>
  </main>
</Layout>
